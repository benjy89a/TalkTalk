# 이 파일을 복사해서 .env.local 을 만들고 값을 채워 넣으세요. (.env.local 은 GitHub 에 올라가지 않습니다)
# 값은 팀장에게 받으세요. 이 파일(.env.example)에는 절대 실제 값을 적지 마세요.

# Supabase 대시보드 → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# (E 담당 AI 기능용) 서버에서만 읽음. NEXT_PUBLIC_ 을 붙이지 말 것
# 쓸 업체의 키만 있어도 됩니다. 관리자 페이지 → AI 설정 탭에서 업체를 바꿀 수 있습니다.
EXAONE_API_KEY=
GEMINI_API_KEY=
# 선택: exaone(비우면 기본) | gemini — 관리자 설정이 "환경변수 따르기"일 때 적용
AI_PROVIDER=
# 선택: Gemini 모델 이름 (비우면 gemini-3.5-flash-lite)
GEMINI_MODEL=
